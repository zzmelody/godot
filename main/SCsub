#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

import main_builders

env.main_sources = []

env_main = env.Clone()

# /*<<----- VEYA_COOKER: native batch entry, no project manager, Script MainLoop or EditorNode. */
if env["veya_cooker"]:
    SConscript("#cooker/SCsub")
    env_main.add_source_files(env.main_sources, ["#cooker/main.cpp", "#cooker/retarget.cpp", "#cooker/character_actions.cpp", "#cooker/character_rig.cpp", "#cooker/character_face.cpp", "#cooker/output_lock.cpp", "performance.cpp"])
else:
    env_main.add_source_files(env.main_sources, "*.cpp")
    if env_main.editor_build and not env_main["disable_3d"]:
        if env.msvc and env.get("veya_bin_dir", ""):
            # Keep private editor crash addresses resolvable without a full PDB.
            env.Append(LINKFLAGS=["/MAP:${TARGET.base}.map"])
        # These offline helpers catch allocation failures before returning to
        # Godot. Keep exception unwinding local to their translation units.
        geometry_tools = env_main.Clone()
        geometry_tools["CXXFLAGS"] = [flag for flag in geometry_tools["CXXFLAGS"] if flag not in ("-fno-exceptions", "/EHs-c-")]
        if env.msvc:
            geometry_tools["CPPDEFINES"] = [item for item in geometry_tools["CPPDEFINES"] if not (isinstance(item, tuple) and item[0] == "_HAS_EXCEPTIONS")]
            geometry_tools.Append(CPPDEFINES=[("_HAS_EXCEPTIONS", 1)], CXXFLAGS=["/EHsc"])
        else:
            geometry_tools.Append(CXXFLAGS=["-fexceptions"])
        geometry_tools.add_source_files(env.main_sources, ["#cooker/content_hash.cpp", "#cooker/minimum_batching.cpp", "#cooker/virtual_geometry_validation.cpp", "#cooker/virtual_geometry_minimum.cpp"])
# /*>>----- VEYA_COOKER */

if env["steamapi"] and env.editor_build:
    env_main.Append(CPPDEFINES=["STEAMAPI_ENABLED"])

if env["tests"]:
    env_main.Append(CPPDEFINES=["TESTS_ENABLED"])

env_main.CommandNoCache(
    "#main/splash.gen.h",
    "#main/splash.png",
    env.Run(main_builders.make_splash),
)

if env_main.editor_build and not env_main["no_editor_splash"]:
    env_main.CommandNoCache(
        "#main/splash_editor.gen.h",
        "#main/splash_editor.png",
        env.Run(main_builders.make_splash_editor),
    )

env_main.CommandNoCache(
    "#main/app_icon.gen.h",
    "#main/app_icon.png",
    env.Run(main_builders.make_app_icon),
)

lib = env_main.add_library("main", env.main_sources)
env.Prepend(LIBS=[lib])
