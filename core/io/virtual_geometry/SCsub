#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

# These bounded, value-only codecs convert allocation failure to typed refusal.
# Keep unwinding local to these codecs; no exception crosses an engine boundary.
codec_env = env.Clone()
codec_env["CXXFLAGS"] = [flag for flag in codec_env["CXXFLAGS"] if flag not in ("-fno-exceptions", "/EHs-c-")]
if env.msvc:
    codec_env["CPPDEFINES"] = [item for item in codec_env["CPPDEFINES"] if not (isinstance(item, tuple) and item[0] == "_HAS_EXCEPTIONS")]
    codec_env.Append(CPPDEFINES=[("_HAS_EXCEPTIONS", 1)])
    codec_env.Append(CXXFLAGS=["/EHsc"])
else:
    codec_env.Append(CXXFLAGS=["-fexceptions"])
codec_env.add_source_files(env.core_sources, ["cluster_codec.cpp", "topology_codec.cpp", "attribute_codec.cpp", "page_codec.cpp", "page_entropy.cpp", "hierarchy.cpp", "model_codec.cpp", "runtime_fixups.cpp"])
