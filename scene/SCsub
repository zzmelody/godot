#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

env.scene_sources = []

# Godot source files
env.add_source_files(env.scene_sources, "*.cpp")

# Chain load SCsubs
SConscript("main/SCsub")
# /*<<----- VEYA_COOKER: no 2D/UI authoring implementation in the asset source graph. */
if not env["veya_cooker"]:
    SConscript("gui/SCsub")
# /*>>----- VEYA_COOKER */
if not env["disable_3d"]:
    SConscript("3d/SCsub")
# /*<<----- VEYA_COOKER: offline 3D resources do not need 2D scene implementations. */
if not env["veya_cooker"]:
    SConscript("2d/SCsub")
# /*>>----- VEYA_COOKER */
SConscript("animation/SCsub")
SConscript("audio/SCsub")
SConscript("resources/SCsub")
# /*<<----- VEYA_COOKER: no live game debugger, node selection popup or viewport panner. */
if not env["veya_cooker"]:
    SConscript("debugger/SCsub")
# /*>>----- VEYA_COOKER */
SConscript("theme/SCsub")

# Build it all as a library
lib = env.add_library("scene", env.scene_sources)
env.Prepend(LIBS=[lib])
